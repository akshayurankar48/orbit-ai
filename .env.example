# Copy to .env.local and fill in your Clerk development keys and LiveKit credentials.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
LAUNCHPAD_APP_ORIGIN=http://127.0.0.1:3212
# Optional absolute SQLite path; default is .data/launchpad.sqlite
# LAUNCHPAD_DB_PATH=
# Used by the authenticated guide-token route. Keep real values out of this file.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
